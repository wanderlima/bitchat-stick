---
interface Props { x: number; y: number; name: string; label: string; scale?: number; labelX?: number; labelAnchor?: string; }
const { x, y, name, label, scale=1, labelX=46, labelAnchor='middle' } = Astro.props;
const labelY = scale < 1 ? 132 + 20 / scale : 156;
const labelStyle = scale < 1 ? `font-size: ${11 / scale}px` : undefined;
---
<g transform={`translate(${x} ${y}) scale(${scale})`} class="peer" data-peer={name}>
  <rect data-peer-slot width="92" height="132" fill="none" />
  <rect class="peer-mask" x="1" y="1" width="90" height="130" rx="12" fill="#000" />
  <g class="peer-outline" fill="none" stroke="#ebdcba" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
    <rect x="1" y="1" width="90" height="130" rx="12" fill="#000" vector-effect="non-scaling-stroke" />
    <rect x="8" y="14" width="76" height="100" rx="4" fill="#000" vector-effect="non-scaling-stroke" />
    <path d="M39 8h14M32 56h28M32 68h16M37 120h18" vector-effect="non-scaling-stroke" />
  </g>
  <text x={labelX} y={labelY} text-anchor={labelAnchor} fill="#ebdcba" class="peer-label" style={labelStyle}>{label}</text>
  <g class="device-accent" opacity="0" fill="none" stroke="#84ff84" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
    <rect x="1" y="1" width="90" height="130" rx="12" fill="#000" vector-effect="non-scaling-stroke" />
    <rect x="8" y="14" width="76" height="100" rx="4" fill="#000" vector-effect="non-scaling-stroke" />
    <path d="M39 8h14M32 56h28M32 68h16M37 120h18" vector-effect="non-scaling-stroke" />
    <text x={labelX} y={labelY} text-anchor={labelAnchor} fill="#84ff84" stroke="none" class="peer-label" style={labelStyle}>{label}</text>
  </g>
</g>
