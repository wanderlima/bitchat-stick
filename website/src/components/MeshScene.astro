---
import Peer from './Peer.astro';
import Device from './Device.astro';
import { desktopScene, mobileScene, meshBounds, peerNames } from '../data/mesh';

interface Props {
  mobile?: boolean;
}
const { mobile = false } = Astro.props;
const variant = mobile ? 'mobile' : 'desktop';
const {
  layout,
  size: [width, height],
  routes,
} = mobile ? mobileScene : desktopScene;
const base = import.meta.env.BASE_URL;
const mask = `mesh-clear-${variant}`;
const stroke = mobile ? 1 : 1.5;
const packetWidth = mobile ? 18 : 30;
---

<svg
  class:list={['mesh-scene', `mesh-${variant}`]}
  data-mesh={variant}
  viewBox={`0 0 ${width} ${height}`}
  aria-hidden="true"
>
  <defs>
    <mask id={mask} maskUnits="userSpaceOnUse" x="0" y="0" width={width} height={height}>
      <rect width={width} height={height} fill="white" />
      {peerNames.map((name) => {
        const box = meshBounds(layout, name);
        const padding = name === 'stick' ? (mobile ? 4 : 8) : mobile ? 2 : 4;
        return (
          <rect
            x={box.x - padding}
            y={box.y - padding}
            width={box.width + 2 * padding}
            height={box.height + 2 * padding}
            fill="black"
          />
        );
      })}
    </mask>
  </defs>
  <g mask={`url(#${mask})`}>
    <g
      class="mesh-routes"
      fill="none"
      stroke="#5a5a5a"
      stroke-width={stroke}
      stroke-linejoin="round"
    >
      {routes.map((route) => (
        <polyline points={route.points.map((point) => point.join(',')).join(' ')} />
      ))}
    </g>
    <g
      class="lit-routes"
      fill="none"
      stroke="#84ff84"
      stroke-width={stroke}
      stroke-linejoin="round"
    >
      {routes.map((route, index) => (
        <g data-route={index} opacity="0">
          <polyline points={route.points.map((point) => point.join(',')).join(' ')} />
        </g>
      ))}
    </g>
    <g class="ripples" fill="none" stroke="#84ff84" stroke-width={stroke}>
      {peerNames.map((name) => {
        const box = meshBounds(layout, name);
        return (
          <circle
            class="ripple"
            data-ripple={name}
            cx={box.x + box.width / 2}
            cy={box.y + box.height / 2}
            r="0"
            opacity="0"
          />
        );
      })}
    </g>
    <g class="packet" opacity="0">
      <image
        href={`${base}icons/envelope.svg`}
        x={-packetWidth / 2}
        y={(-packetWidth * 11) / 30}
        width={packetWidth}
        height={(packetWidth * 22) / 30}
      />
    </g>
  </g>
  {peerNames.map((name) =>
    name === 'stick' ? (
      <Device {...layout[name]} screens={['home', 'writing', 'confirm', 'queued', 'received']} />
    ) : (
      <Peer
        {...layout[name]}
        name={name}
        label={mobile || name === 'relay' ? name.toUpperCase() : `PEER / ${name.toUpperCase()}`}
      />
    ),
  )}
</svg>
