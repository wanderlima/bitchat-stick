---
import Peer from './Peer.astro';
import Device from './Device.astro';
import { desktopRoutes, mobileRoutes } from '../data/mesh';
interface Props { mobile?: boolean; }
const { mobile=false } = Astro.props;
const routes = mobile ? mobileRoutes : desktopRoutes;
const base = import.meta.env.BASE_URL;
const stroke = mobile ? 2 : 4;
---
<svg class:list={['mesh-scene', mobile ? 'mesh-mobile' : 'mesh-desktop']} data-mesh={mobile ? 'mobile' : 'desktop'} viewBox={mobile ? '0 0 327 420' : '0 0 1600 760'} aria-hidden="true">
  <g class="mesh-routes" fill="none" stroke="#082d21" stroke-width={stroke}>
    {routes.map(route => <polyline points={route.points.map(p => p.join(',')).join(' ')} />)}
  </g>
  <g fill="#84ff84" class="lit-routes">
    {routes.map((route, index) => <g data-route={index} opacity="0">
      {route.points.slice(1).map((point, i) => {
        const from=route.points[i]; const vertical=point[0]===from[0];
        return <rect x={Math.min(point[0],from[0])-(vertical ? stroke/2 : 0)} y={Math.min(point[1],from[1])-(vertical ? 0 : stroke/2)} width={vertical ? stroke : Math.abs(point[0]-from[0])} height={vertical ? Math.abs(point[1]-from[1]) : stroke} data-leg={i} data-axis={vertical ? 'y' : 'x'} style="transform-box: view-box; transform-origin: 0px 0px" />;
      })}
    </g>)}
  </g>
  {mobile ? <>
    <Peer x={-5} y={151} name="west" label="WEST" scale={.28} labelX={18} labelAnchor="start" />
    <Peer x={66} y={266} name="relay" label="RELAY" scale={.42} />
    <Peer x={299} y={29} name="north" label="NORTH" scale={.28} labelX={92} labelAnchor="end" />
    <Peer x={314} y={277} name="east" label="EAST" scale={.28} labelX={46} labelAnchor="end" />
  </> : <>
    <Peer x={14} y={424} name="west" label="PEER / WEST" />
    <Peer x={714} y={524} name="relay" label="RELAY" />
    <Peer x={1334} y={84} name="north" label="PEER / NORTH" />
    <Peer x={1444} y={514} name="east" label="PEER / EAST" />
  </>}
  <Device x={mobile ? 101.6667 : 974} y={mobile ? 21.6667 : 157} scale={mobile ? .8333333 : 1} screens={['home','writing','confirm','queued','received']} />
  <g class="packet" opacity="0"><image href={`${base}icons/envelope.svg`} x="-15" y="-11" width="30" height="22" /></g>
</svg>
